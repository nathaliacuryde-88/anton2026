{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node10",
    "ignoreDeprecations": "6.0",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": ".scripts-build"
  },
  "include": ["scripts/**/*.ts", "src/astro/**/*.ts", "src/data/**/*.ts"]
}
